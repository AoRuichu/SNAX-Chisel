                <mxCell id="p4_innerNext" value="&lt;b&gt;innerNext = innerAccReg + laneSum&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;final block sum at anchor b_value = minProductExp − fracBitsElem&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="870" y="170" width="520" height="50" as="geometry"/>
                </mxCell>

                <mxCell id="p4_signsplit" value="&lt;b&gt;Sign + Magnitude split&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;kSign = innerNext(accInnerW − 1)&lt;br&gt;kMag = sign ? −innerNext : innerNext&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="870" y="250" width="320" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p4_lzc" value="&lt;b&gt;LZC + Normalize&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;lzc = PriorityEncoder(Reverse(kMag))&lt;br&gt;normalized = kMag &amp;lt;&amp;lt; lzc&lt;br&gt;(leading 1 at bit magW − 1)&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="1220" y="250" width="380" height="65" as="geometry"/>
                </mxCell>

                <mxCell id="p4_rne" value="&lt;b&gt;RNE Round &amp; mantissa extract&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;mantRaw = normalized[magW−2 : magW−1−M]&lt;br&gt;guard / round / sticky from below&lt;br&gt;roundUp = G &amp;amp; (mantRaw[0] | R | sticky)&lt;br&gt;mCarry detects rounding overflow&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="870" y="355" width="380" height="100" as="geometry"/>
                </mxCell>

                <mxCell id="p4_expform" value="&lt;b&gt;Biased-exp formula&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;biased_exp = (magW − 1 + b_value + 127) − lzc + scaleAdj + mCarry&lt;br&gt;&lt;br&gt;b_value = minProductExp − fracBitsElem&lt;br&gt;scaleAdj = (scaleA − bias) + (scaleB − bias)&lt;br&gt;(UE8M0 only — non-UE8M0 falls back to Arch-IV.a)&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="1280" y="355" width="340" height="100" as="geometry"/>
                </mxCell>

                <mxCell id="p4_satcheck" value="&lt;b&gt;Overflow / Underflow clamp&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;newExpRaw ≥ 255 ⇒ +Inf&lt;br&gt;newExpRaw ≤ 0 / isMagZero ⇒ 0&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="870" y="490" width="380" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="p4_blockPartial" value="&lt;b&gt;blockPartialFP&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;{kSign[1], finalBiasedExp[8], finalMantExp[M]}&lt;br&gt;= 1 + 8 + M FP bits&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="1280" y="490" width="340" height="65" as="geometry"/>
                </mxCell>

                <mxCell id="p4_fpnadder" value="&lt;b&gt;FPNAdder (M-bit mant)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="1100" y="610" width="240" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p4_outerReg" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;outerAccReg&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;FP accumulator (across blocks)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;1 + 8 + M = fpNW bits&lt;br&gt;M = AccPrecision.recommended(K)&lt;br&gt;&lt;b&gt;same width as buildBlockDeferred&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;" vertex="1" parent="1">
                    <mxGeometry x="870" y="700" width="700" height="120" as="geometry"/>
