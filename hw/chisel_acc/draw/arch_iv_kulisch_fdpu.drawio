                <mxCell id="p4_in_a" value="&lt;b&gt;op_a_i&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;V × wA bits&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="80" y="160" width="140" height="50" as="geometry"/>
