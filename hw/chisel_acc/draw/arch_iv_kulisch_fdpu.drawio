                <mxCell id="p4_title" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Arch-IV.b Kulisch FDPU Datapath&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;i&gt;wide fixed-point inner accumulator within each MX block · scale apply &amp; LZC deferred to block boundary · FixedFPReductionTree bypassed&lt;/i&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="300" y="20" width="1000" height="60" as="geometry"/>
