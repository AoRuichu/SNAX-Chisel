                </mxCell>
                <mxCell id="p4_left_title" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Per-cycle (intra-block) · runs cyclesPerBlock times&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="20" y="110" width="760" height="35" as="geometry"/>
