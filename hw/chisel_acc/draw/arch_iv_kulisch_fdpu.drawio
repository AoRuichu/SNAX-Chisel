                <mxCell id="p4_in_b" value="&lt;b&gt;op_b_i&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;V × wB bits&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="260" y="160" width="140" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p4_in_sa" value="&lt;b&gt;share_exp_A_i&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;8 bits · constant in block&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="450" y="160" width="160" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p4_in_sb" value="&lt;b&gt;share_exp_B_i&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;8 bits · constant in block&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="630" y="160" width="160" height="50" as="geometry"/>
                </mxCell>

                <mxCell id="p4_macs" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;CustomOperator × V (lane MACs)&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;output per lane: (sign, exp_signed, mant)&lt;br&gt;mant is mProd-bit unsigned product, exp = adjExpA + adjExpB&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="80" y="245" width="320" height="80" as="geometry"/>
                </mxCell>

                <mxCell id="p4_treebypass" value="&lt;b&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;✗ FixedFPReductionTree bypassed&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;no maxExp comparator&lt;br&gt;no per-cycle LZC, normalize, RNE&lt;br&gt;no DirectToFPn / ScaleAddition&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="450" y="245" width="280" height="80" as="geometry"/>
                </mxCell>

                <mxCell id="p4_align" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Per-lane align to GLOBAL anchor&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;b_shift = minProductExp (compile-time constant)&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;for each lane i:&lt;br&gt;&amp;nbsp;&amp;nbsp;shiftAmt_i = exp_i − b_shift   (range [0, R])&lt;br&gt;&amp;nbsp;&amp;nbsp;extended_i = {0_pad, mant_i}  (magW bits)&lt;br&gt;&amp;nbsp;&amp;nbsp;shifted_i = extended_i &amp;lt;&amp;lt; shiftAmt_i  (LEFT-shift)&lt;br&gt;&amp;nbsp;&amp;nbsp;aligned_i = sign_i ? −shifted_i : shifted_i&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="80" y="360" width="640" height="160" as="geometry"/>
                </mxCell>

                <mxCell id="p4_align_note" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;i&gt;vs. Generic: right-shift to per-cycle maxExp · Kulisch: left-shift to compile-time minProductExp&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="80" y="525" width="640" height="30" as="geometry"/>
                </mxCell>

                <mxCell id="p4_addtree" value="" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fixedSize=1;rotation=-180;" vertex="1" parent="1">
                    <mxGeometry x="220" y="585" width="360" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p4_addtree_lbl" value="&lt;b&gt;Signed Integer Adder Tree (V → 1)&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;width-preserving · log₂V levels&lt;br&gt;laneSum = Σ aligned_i&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="220" y="590" width="360" height="50" as="geometry"/>
                </mxCell>

                <mxCell id="p4_laneSum_lbl" value="&lt;b&gt;laneSum&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;SInt(accInnerW.W)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="330" y="660" width="140" height="35" as="geometry"/>
                </mxCell>

                <mxCell id="p4_innersum" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b&gt;+&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="270" y="720" width="50" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p4_innersum_lbl" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;width-preserving SInt add&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="330" y="725" width="200" height="35" as="geometry"/>
                </mxCell>

                <mxCell id="p4_innerReg" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;innerAccReg&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;wide fixed-point Kulisch accumulator&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;SInt(accInnerW.W) = SInt(1 + magW.W)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;magW = R + mProd + log₂(C·V)&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;E5M2×E5M2 / vec=4 / blk=32 / K=16384:&lt;br&gt;magW = 58 + 6 + 5 = 69 ⇒ accInnerW = &lt;b&gt;70 bits&lt;/b&gt;&lt;br&gt;(vs. MXDOTP 95-bit fixed acc)&lt;/font&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;" vertex="1" parent="1">
                    <mxGeometry x="80" y="800" width="640" height="180" as="geometry"/>
                </mxCell>

                <mxCell id="p4_block_done_box" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;blockCnt mod cyclesPerBlock&lt;br&gt;→ blockDone @ cycle (C−1)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="80" y="1010" width="320" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="p4_reset_inner" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;i&gt;on blockDone: innerAccReg ← 0&lt;/i&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
