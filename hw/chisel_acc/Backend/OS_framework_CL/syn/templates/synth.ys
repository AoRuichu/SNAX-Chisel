# Yosys synthesis script — NanGate 45nm
# Generated by syn.sh — do not edit manually; edit syn/templates/synth.ys instead.

# ---- Read RTL ----
{READ_VERILOG_CMDS}

# ---- Override RTL parameters (if any) ----
{CHPARAM_CMDS}

# ---- Elaborate ----
hierarchy -check -top {DESIGN_NAME}

# ---- Synthesis ----
# -noflatten preserves module hierarchy (equivalent to DC -no_auto_ungroup)
synth -top {DESIGN_NAME} {SYNTH_FLAGS}

# ---- Technology mapping ----
# Map flip-flops to library cells
dfflibmap -liberty {LIB_FILE}

# Map combinational logic and optimise timing/area
# -retime allows registers to move across combinational cones
abc -liberty {LIB_FILE} {ABC_FLAGS}

# ---- Clean up dangling wires ----
clean

# ---- Area report (Chip area for module line parsed by data_to_excel.sh) ----
tee -o {PROJ_DIR}/syn/reports/{RUN_ID}/area_report.rpt stat -liberty {LIB_FILE}

# ---- Design rule check ----
check

# ---- Write gate-level netlist ----
write_verilog -noattr {PROJ_DIR}/syn/outputs/{RUN_ID}/{DESIGN_NAME}_mapped.v
