# Yosys synthesis script — NanGate 45nm
# Generated by syn.sh — do not edit manually; edit syn/templates/synth.ys instead.

# ---- Read RTL ----
read_verilog -sv /users/micas/scuycken/no_backup/OS_framework_CL/rtl/src/mac_8bit.v


# ---- Override RTL parameters (if any) ----


# ---- Elaborate ----
hierarchy -check -top mac_8bit

# ---- Synthesis ----
# -noflatten preserves module hierarchy (equivalent to DC -no_auto_ungroup)
synth -top mac_8bit 

# ---- Technology mapping ----
# Map flip-flops to library cells
dfflibmap -liberty /users/micas/scuycken/Claude/RTL_LLM_Loop_v1.4/OpenSource/PDK/OpenROAD-flow-scripts/flow/platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib

# Map combinational logic and optimise timing/area
# -retime allows registers to move across combinational cones
abc -liberty /users/micas/scuycken/Claude/RTL_LLM_Loop_v1.4/OpenSource/PDK/OpenROAD-flow-scripts/flow/platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib 

# ---- Clean up dangling wires ----
clean

# ---- Area report (Chip area for module line parsed by data_to_excel.sh) ----
tee -o /users/micas/scuycken/no_backup/OS_framework_CL/syn/reports/run_001/area_report.rpt stat -liberty /users/micas/scuycken/Claude/RTL_LLM_Loop_v1.4/OpenSource/PDK/OpenROAD-flow-scripts/flow/platforms/nangate45/lib/NangateOpenCellLibrary_typical.lib

# ---- Design rule check ----
check

# ---- Write gate-level netlist ----
write_verilog -noattr /users/micas/scuycken/no_backup/OS_framework_CL/syn/outputs/run_001/mac_8bit_mapped.v
