report_timing  -max_paths 10 > $REPORTS_DIR/timing.rpt
report_power   > $REPORTS_DIR/power.rpt
report_cell    > $REPORTS_DIR/cells.rpt

# ── Write netlist ─────────────────────────────────────────────────────────────
write -format verilog -hierarchy -output $RESULTS_DIR/$DESIGN_NAME\_netlist.v
