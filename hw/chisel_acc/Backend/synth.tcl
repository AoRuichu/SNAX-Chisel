set PDK_ROOT     "/esat/micas_raid/users/h05d4a_students/conda-env/share/pdk"
set TAG          "260327-013456_INT8_E2M1_UE8M0_vec1"

# ── Technology libraries ──────────────────────────────────────────────────────
set _lib_file_str [exec find $STD_CELL_LIB_ROOT -name "*.lib" -maxdepth 4]
set search_path  [concat $search_path [list /esat/micas_raid/users/h05d4a_students/conda-env/share/pdk/standard_cell_libraries]]
set target_library  [split [string trim $_lib_file_str]"\n"]
set link_library    [concat "*" $target_library]

puts "Using [llength $target_library] library file(s):"
foreach lib $target_library { puts "  $lib" }

# ── Output directories ────────────────────────────────────────────────────────
set RESULTS_DIR "./runs/$TAG/results"
set REPORTS_DIR "./runs/$TAG/reports"
file mkdir $RESULTS_DIR
file mkdir $REPORTS_DIR

# ── Read & elaborate ─────────────────────────────────────────────────────────
analyze -format sverilog $RTL_FILE
