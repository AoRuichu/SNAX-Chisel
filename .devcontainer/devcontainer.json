{
  "name": "SNAX Full Stack",
  "dockerComposeFile": "docker-compose.yml",
  "service": "snax_dev",
  "workspaceFolder": "/workspaces/snax_cluster",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "chipsalliance.verible",
        "wavetrace.wavetrace",
        "mshr-h.veriloghdl",
        "ms-python.python",
        "ms-vscode.cpptools"
      ]
    }
  },
  "remoteUser": "root",
  "remoteEnv": {
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${containerWorkspaceFolder}"
}
}